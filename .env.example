# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# --- Stripe (add these once the site is reachable; test keys are fine first) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Printify (Account > Connections > API for the token) ---
PRINTIFY_API_KEY=
# Shop ID: printify.com/app/shop/{SHOP_ID}
PRINTIFY_SHOP_ID=
# Product ID: printify.com/app/products/{PRODUCT_ID}
PRINTIFY_PRODUCT_ID=

# --- App ---
# Local dev: http://localhost:3000  |  Production: https://dangerousdinodrivers.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Analytics / Marketing (optional) ---
# TikTok Pixel ID (TikTok Ads Manager > Assets > Events). Pixel only loads if set.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). GA only loads if set.
NEXT_PUBLIC_GA_ID=

# --- Emails (Resend) + Data (Supabase) — order/welcome/review emails & storage ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM=Dangerous Dino Drivers <hello@dangerousdinodrivers.com>
CRON_SECRET=
